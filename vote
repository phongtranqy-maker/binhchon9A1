<!DOCTYPE html>
<html lang = "vi">
    <head>
        <meta charset = "UTF-8">
        <meta name = "viewport" content = "width=device-width, initial-scale=1.0">
        <title>BÌNH CHỌN 20/10</title>
        <style>
            body {
                background: linear-gradient(
                    to right,
                    #FFE5EE,
                    #FEF8FB,
                    #F4E8FF
                );
                font-family: Arial, sans-serif;
                color: #332A33;
                margin: 0;
                padding: 0;
            }
            .site-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 16px;
                padding: 20px max(5%, calc((100% - 1100px) / 2));
                border-bottom: 1px solid #F5E1E8;
                background: #FFFFFFC9;
                backdrop-filter: blur(8px);
            }
            .brand {
                color: #B83D6B;
                font-weight: 800;
                letter-spacing: .04em;
            }
            .tag {
                background: #FFF0F5;
                color: #B83D6B;
                border: 1px solid #F1D4DF;
                border-radius: 999px;
                padding: 8px 12px;
                font-size: 12px;
                font-weight: 700;
            }
            .title {
                text-align: center;
                color: #A93E68;
            }
            .rules {
                color: #B7928C;
            }
            .section-heading {
                margin-bottom: 20px;
            }
            .section-heading h2 {
                margin: 0 0 6px;
                font-size: 24px;
                font-weight: 700;
                color: #5B4457;
            }
            .section-heading p {
                margin: 0;
                font-size: 13px;
                color: #8C7180;
            }
            .category-grid {
                display: grid;
                grid-template-columns: repeat(4, minmax(0, 1fr));
                gap: 12px;
            }
            .category-button {
                padding: 16px;
                text-align: left;
                background: #FFFFFF;
                border: 1px solid #F1D4DF;
                border-radius: 16px;
                color: #493640;
                font-size: 14px;
                font-weight: 600;
                cursor: pointer;
                transition: 0.2s ease;
            }
            .category-button p {
                color: #B83D6B;
                font-size: 10px;
            }
            .category-button:hover {
                background: #FFF0F5;
                border-color: #D98BA8;
                transform: translateY(-2px);
            }
            @media (max-width: 420px) {
                .category-grid {
                    grid-template-columns: 1fr;
                }
            }
        </style>
    </head>
